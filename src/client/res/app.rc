#pragma code_page(65001)
#include <windows.h>

// 程序图标（资源 ID 1，代码里用 MAKEINTRESOURCEW(1) 取）
1 ICON "icon.ico"

// 应用程序清单（DPI、ComCtl v6、asInvoker）
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION     1,8,0,0
    PRODUCTVERSION  1,8,0,0
    FILEFLAGSMASK   0x3fL
    FILEFLAGS       0x0L
    FILEOS          0x40004L
    FILETYPE        0x1L
    FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "XEKernel"
            VALUE "FileDescription",  "U盘文件复制器"
            VALUE "FileVersion",      "1.8.0.0"
            VALUE "InternalName",     "UsbCopy"
            VALUE "LegalCopyright",   "Copyright (C) XEKernel"
            VALUE "OriginalFilename", "UsbCopy.exe"
            VALUE "ProductName",      "U盘文件复制器"
            VALUE "ProductVersion",   "1.8.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
